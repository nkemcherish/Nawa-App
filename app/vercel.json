{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/parse.py": {
      "maxDuration": 300,
      "includeFiles": "{server.py,categorise.py,statement_ai.py}"
    }
  },
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]},
    {"source": "/app.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
